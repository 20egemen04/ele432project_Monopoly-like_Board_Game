// board_display.sv

// add other signals later
module board_display(
    input logic [9:0] x, y,
    output logic [7:0] r, g, b,
    input logic control_signal // Example control signal
);

    logic [7:0] box_static_r, box_static_g, box_static_b;
    logic [7:0] text_r, text_g, text_b;

    board_boxes_static boxes_static(
        .x(x), .y(y),
        .r(box_static_r), .g(box_static_g), .b(box_static_b)
    );

    board_texts_static texts_static(
        .x(x), .y(y),
        .r(text_r), .g(text_g), .b(text_b),
    );

    always_comb begin
        // Simple priority: if text is on, show text. Otherwise, show boxes.
        if ({text_r, text_g, text_b} != 24'h000000) begin
            r = text_r;
            g = text_g;
            b = text_b;
        end else begin
            r = box_static_r;
            g = box_static_g;
            b = box_static_b;
        end
    end

endmodule




module board_texts_static #(
    parameter BLACK_RGB = 24'h000000,
    parameter BLACK_TEXT_RGB = 24'h010101, // Slightly off-black to prevent text from being completely invisible when overlapping with box borders
    parameter WHITE_TEXT_RGB = 24'hFFFFFF
    //parameter P1_TEXT_RGB = 24'hFF0000
)(
    input logic [9:0] x, y,
    output logic [7:0] r, g, b
);

    logic [10:0] master_rom_addr;
    logic [7:0] master_rom_data;

    logic [10:0] text_addr [127:0];
    logic text_pix [127:0];
    logic text_box [127:0];

    always_comb begin
        // Only give the ROM address to the module that the VGA beam is currently inside
        if (text_box[0]) master_rom_addr = text_addr[0];
        else if (text_box[1]) master_rom_addr = text_addr[1];
        else if (text_box[2]) master_rom_addr = text_addr[2];
        else if (text_box[3]) master_rom_addr = text_addr[3];
        else if (text_box[4]) master_rom_addr = text_addr[4];
        else if (text_box[5]) master_rom_addr = text_addr[5];
        else if (text_box[6]) master_rom_addr = text_addr[6];
        else if (text_box[7]) master_rom_addr = text_addr[7];
        else if (text_box[8]) master_rom_addr = text_addr[8];
        else if (text_box[9]) master_rom_addr = text_addr[9];
        else if (text_box[10]) master_rom_addr = text_addr[10];
        else if (text_box[11]) master_rom_addr = text_addr[11];
        else if (text_box[12]) master_rom_addr = text_addr[12];
        else if (text_box[13]) master_rom_addr = text_addr[13];
        else if (text_box[14]) master_rom_addr = text_addr[14];
        else if (text_box[15]) master_rom_addr = text_addr[15];
        else if (text_box[16]) master_rom_addr = text_addr[16];
        else if (text_box[17]) master_rom_addr = text_addr[17];
        else if (text_box[18]) master_rom_addr = text_addr[18];
        else if (text_box[19]) master_rom_addr = text_addr[19];
        else if (text_box[20]) master_rom_addr = text_addr[20];
        // Add more 'else if' statements here as you add more words!

        else
        master_rom_addr = 9'd0;  // Default to space when beam is empty
    end

    font_rom fontROM(
        .font_addr(master_rom_addr),
        .font_data_out(master_rom_data)
    );

    text_display #(.MAX_CHARS(1'd1)) tile_0_text_0
    (
        .x(x), .y(y),
        .start_x(10'd443), .start_y(10'd435), 
        .enable_display(1'b1),  // Always ON for the static board
        .text_string("0"),
        .font_row(master_rom_data), 
        .font_rom_addr(text_addr[0]), 
        .pixel_on(text_pix[0]), .in_box(text_box[0])
    );

    text_display #(.MAX_CHARS(3'd5)) tile_0_text_1
    (
        .x(x), .y(y),
        .start_x(10'd427), .start_y(10'd443), 
        .enable_display(1'b1),  // Always ON for the static board
        .text_string("START"),
        .font_row(master_rom_data), 
        .font_rom_addr(text_addr[1]), 
        .pixel_on(text_pix[1]), .in_box(text_box[1])
    );

    text_display #(.MAX_CHARS(3'd5)) tile_0_text_2
    (
        .x(x), .y(y),
        .start_x(10'd427), .start_y(10'd451), 
        .enable_display(1'b1),  // Always ON for the static board
        .text_string("$2000"),
        .font_row(master_rom_data), 
        .font_rom_addr(text_addr[2]), 
        .pixel_on(text_pix[2]), .in_box(text_box[2])
    );

    text_display #(.MAX_CHARS(1'd1)) tile_1_text_0
