    always_comb begin
        // Simple priority: if text is on, show white text. Otherwise, show black (transparent).
        if (text_pix[0] || text_pix[1] || text_pix[2] || text_pix[9] || text_pix[10] || text_pix[17] || text_pix[18] || text_pix[19]) begin
            {r, g, b} = WHITE_TEXT_RGB;
        end else if (text_pix) begin
            {r, g, b} = BLACK_TEXT_RGB;
        end else begin
            {r, g, b} = BLACK_RGB;
