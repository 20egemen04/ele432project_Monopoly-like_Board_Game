        .text_string("E1"),
        .font_row(master_rom_data), 
        .font_rom_addr(text_addr[4]), 
        .pixel_on(text_pix[4]), .in_box(text_box[4])
    );

    text_display #(.MAX_CHARS(1'd1)) tile_2_text_0
